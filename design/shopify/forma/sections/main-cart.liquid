<section class="shell cart-page"><p class="eyebrow">Your collection</p><h1>A few good things.</h1>
  {% if cart.item_count > 0 %}<form action="{{ routes.cart_url }}" method="post">
    {% for item in cart.items %}<div class="cart-row"><a href="{{ item.url }}">{% if item.image %}{{ item.image | image_url: width: 250 | image_tag: loading: 'lazy' }}{% endif %}</a><div><a href="{{ item.url }}">{{ item.product.title | escape }}</a><p>{{ item.variant.title | escape }}</p><p>{{ item.final_line_price | money }}</p><label for="quantity-{{ item.key | escape }}">Quantity</label><input id="quantity-{{ item.key | escape }}" type="number" name="updates[]" value="{{ item.quantity }}" min="0" step="1"><a href="{{ item.url_to_remove }}">Remove</a>{% for discount in item.line_level_discount_allocations %}<p>{{ discount.discount_application.title | escape }}: -{{ discount.amount | money }}</p>{% endfor %}</div></div>{% endfor %}
    <div class="cart-total"><span>Subtotal</span><strong>{{ cart.total_price | money }}</strong></div><p class="fine-print">Taxes and shipping calculated at checkout.</p><div class="cart-actions"><button class="secondary-button" name="update" type="submit">Update bag</button><button class="primary-button" name="checkout" type="submit">Checkout &rarr;</button></div>
  </form>{% else %}<p>Your bag is empty.</p><a class="text-link" href="{{ routes.all_products_collection_url }}">Explore the collection &rarr;</a>{% endif %}
</section>
{% schema %}{ "name": "Cart", "settings": [] }{% endschema %}

<section class="hero">
  <div class="hero-copy"><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h1>{{ section.settings.heading | escape }}</h1><p>{{ section.settings.description | escape }}</p><a class="text-link" href="#collection">Discover the collection &rarr;</a></div>
  <div class="hero-art">{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 1600 | image_tag: widths: '500,800,1200,1600', sizes: '(min-width: 750px) 50vw, 100vw', loading: 'eager' }}{% else %}{{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder' }}{% endif %}</div>
</section>
<section class="collection shell" id="collection">
  <p class="eyebrow">The everyday edit</p><h2>A few good things.</h2>
  {% assign featured = section.settings.collection %}
  {% if featured == blank %}{% assign featured = collections.all %}{% endif %}
  <div class="product-grid">{% for product in featured.products limit: 6 %}{% render 'product-card', product: product %}{% else %}<p>Choose a collection in the theme editor and add your products to begin.</p>{% endfor %}</div>
  {% if featured != blank %}<a class="text-link" href="{{ featured.url }}">Explore all objects &rarr;</a>{% endif %}
</section>
{% schema %}
{
  "name": "Forma collection",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The everyday, a little more considered." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Objects with feeling." },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Small, useful, quietly beautiful. A collection of things that quietly earn their place in everyday life." },
    { "type": "image_picker", "id": "image", "label": "Hero photograph" },
    { "type": "collection", "id": "collection", "label": "Featured collection" }
  ],
  "presets": [{ "name": "Forma collection" }]
}
{% endschema %}

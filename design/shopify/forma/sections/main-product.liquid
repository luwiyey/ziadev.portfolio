<section class="product-detail shell">
  <div class="product-gallery">{% for media in product.media %}{% if media.media_type == 'image' %}{{ media | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '400,700,1000,1400', sizes: '(min-width: 750px) 50vw, 100vw' }}{% endif %}{% endfor %}</div>
  <div class="product-info"><a class="eyebrow" href="{{ routes.all_products_collection_url }}">&larr; All objects</a><h1>{{ product.title | escape }}</h1><p>{{ product.price | money }}</p><div class="rte">{{ product.description }}</div>
    {% form 'product', product %}
      {{ form.errors | default_errors }}
      <label for="variant-{{ section.id }}">Choose an option</label>
      <select id="variant-{{ section.id }}" name="id">{% for variant in product.variants %}<option value="{{ variant.id }}"{% if variant == product.selected_or_first_available_variant %} selected{% endif %}{% unless variant.available %} disabled{% endunless %}>{{ variant.title | escape }} - {{ variant.price | money }}{% unless variant.available %} / Sold out{% endunless %}</option>{% endfor %}</select>
      <label for="quantity-{{ section.id }}">Quantity</label><input id="quantity-{{ section.id }}" type="number" name="quantity" value="1" min="1" step="1" required>
      <button class="primary-button" type="submit"{% unless product.available %} disabled{% endunless %}>{% if product.available %}Add to bag{% else %}Sold out{% endif %}</button>
    {% endform %}
    <p class="fine-print">Taxes and shipping are calculated at checkout. Fulfillment and returns follow this store's published policies.</p>
  </div>
</section>
{% schema %}{ "name": "Product", "settings": [] }{% endschema %}
